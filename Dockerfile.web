# React 프론트(frontend/) 빌드 → nginx 정적 서빙 (포트 3000). /api 는 api 서비스(8000)로 프록시.
# 빌드 컨텍스트는 저장소 루트 (docker-compose: build: {context: ., dockerfile: Dockerfile.web})
FROM node:20-alpine AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
# 브라우저가 부를 API 베이스. nginx 가 같은 오리진의 /api 를 api 서비스로 넘긴다.
ARG VITE_API_BASE=/api
ENV VITE_API_BASE=$VITE_API_BASE
RUN npm run build

FROM nginx:alpine
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 3000
