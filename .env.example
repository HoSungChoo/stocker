# 복사해서 .env로 사용: cp .env.example .env
STOCKER_DB_URL=postgresql+psycopg://stocker:stocker@localhost:5432/stocker
FRED_API_KEY=
STOCKER_DATA_DIR=./data

# --- 아침 보고서 (모두 선택. 비워 두면 기본값/꺼짐) ---
REPORT_TIME=              # 매일 실행 시각 KST HH:MM, 기본 07:30
REPORT_WINDOWS=           # 쉼표 구분 창 길이, 기본 120,250
REPORT_LLM=off
OPENAI_API_KEY=           # REPORT_LLM=on 과 함께 있으면 LLM 요약 1단락 추가 (유료). 비우면 꺼짐
OPENAI_MODEL=gpt-6.1-sol  # 고정. 바꾸지 않는다
SMTP_HOST=                # SMTP_* 와 REPORT_EMAIL_TO가 모두 있어야 이메일 전송
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
REPORT_EMAIL_TO=
TELEGRAM_BOT_TOKEN=       # 둘 다 있어야 텔레그램 전송
TELEGRAM_CHAT_ID=
